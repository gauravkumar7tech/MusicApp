<!DOCTYPE html>
<html>
<head>
    <title>Add Music - Music Discovery Hub</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
<canvas id="bg-canvas" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;"></canvas>
<%- include('_nav', { activePage: '' }) %>

<main class="main">
    <div class="container">
        <section class="hero">
            <h2><i class="fas fa-plus-circle"></i> Add New Track</h2>
            <p>Share your music with the world</p>
        </section>

        <div class="form-container">
            <% if (typeof error !== 'undefined') { %>
                <div class="error-message">
                    <i class="fas fa-exclamation-triangle"></i> <%= error %>
                </div>
            <% } %>

            <form method="POST" action="/music/add" class="music-form" enctype="multipart/form-data">

                <div class="form-group">
                    <label><i class="fas fa-music"></i> Song Title</label>
                    <input type="text" name="title" placeholder="Enter song title" required>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-user"></i> Artist</label>
                    <input type="text" name="artist" placeholder="Enter artist name" required>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-compact-disc"></i> Album</label>
                    <input type="text" name="album" placeholder="Enter album name" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-tag"></i> Genre</label>
                        <select name="genre" required>
                            <option value="">Select Genre</option>
                            <option value="Pop">Pop</option>
                            <option value="Rock">Rock</option>
                            <option value="Jazz">Jazz</option>
                            <option value="Classical">Classical</option>
                            <option value="Electronic">Electronic</option>
                            <option value="Hip Hop">Hip Hop</option>
                            <option value="Ballad">Ballad</option>
                            <option value="Punjabi">Punjabi</option>
                            <option value="Haryanvi">Haryanvi</option>
                            <option value="Country">Country</option>
                            <option value="R&B">R&B</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-magic"></i> Mood</label>
                        <select name="mood">
                            <option value="">Auto (from genre)</option>
                            <option value="upbeat">⚡ Upbeat</option>
                            <option value="intense">🔥 Intense</option>
                            <option value="melancholic">🌧️ Melancholic</option>
                            <option value="chill">🌊 Chill</option>
                            <option value="contemplative">🌙 Contemplative</option>
                            <option value="powerful">💪 Powerful</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-calendar"></i> Year</label>
                        <input type="number" name="year" placeholder="2025" min="1900" max="2025" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-clock"></i> Duration</label>
                        <input type="text" name="duration" placeholder="3:45" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-star"></i> Rating (1–10)</label>
                        <input type="number" name="rating" placeholder="8" min="1" max="10" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-bolt"></i> Energy Level (1–10)</label>
                        <input type="number" name="energy" placeholder="5" min="1" max="10">
                    </div>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-comment"></i> Description</label>
                    <textarea name="description" placeholder="Tell us about this song..." required></textarea>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" name="isLive" value="true" style="width:auto;margin-right:0.5rem;">
                        <i class="fas fa-circle" style="color:#ff4444;font-size:0.7rem;"></i> This is a Live recording
                    </label>
                </div>

                <div class="form-group">
                    <label><i class="fas fa-file-audio"></i> Audio File (MP3 / WAV)</label>
                    <input type="file" name="audioFile" accept=".mp3,.wav,.m4a">
                </div>

                <button type="submit" class="submit-btn">
                    <i class="fas fa-plus"></i> Add Track
                </button>
            </form>
        </div>
    </div>
</main>

<footer class="footer">
    <div class="container"><p>&copy; 2024 Music Discovery Hub. Find your rhythm.</p></div>
</footer>

<script src="/js/player.js"></script>
<script src="/js/canvas-bg.js"></script>
</body>
</html>

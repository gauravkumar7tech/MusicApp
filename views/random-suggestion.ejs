<!DOCTYPE html>
<html>
<head>
    <title>Random Music - Music Discovery Hub</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
<%- include('_nav', { activePage: '' }) %>

<main class="main">
    <div class="container">
        <div class="random-header">
            <h2><i class="fas fa-dice"></i> Your Random Discovery</h2>
            <p>Let music surprise you with something new</p>
        </div>

        <% if (music) { %>
        <div class="featured-music">
            <div class="featured-content">
                <div class="music-artwork">
                    <i class="fas fa-compact-disc"></i>
                </div>
                <div class="music-details">
                    <h3><%= music.title %></h3>
                    <h4>by <a href="/music/artist/<%= encodeURIComponent(music.artist) %>" class="artist-link"><%= music.artist %></a></h4>
                    <div class="music-meta">
                        <span class="genre-tag"><%= music.genre %></span>
                        <span class="year-tag"><%= music.year %></span>
                    </div>
                    <div class="rating-large">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <i class="fas fa-star <%= music.rating >= i*2 ? 'filled' : '' %>"></i>
                        <% } %>
                        <span><%= music.rating %>/10</span>
                    </div>
                    <div class="music-info-detailed">
                        <p><i class="fas fa-compact-disc"></i> Album: <%= music.album %></p>
                        <p><i class="fas fa-clock"></i> Duration: <%= music.duration %></p>
                    </div>
                    <p class="description"><%= music.description %></p>

                    <!-- Single-track list for sticky player -->
                    <div id="track-list">
                        <div class="music-card"
                             style="display:none"
                             data-index="0"
                             data-src="/songs/<%= music.audioFile %>"
                             data-title="<%= music.title %>"
                             data-artist="<%= music.artist %>"
                             data-id="<%= music._id %>">
                        </div>
                    </div>

                    <div class="action-buttons" style="margin-top:1rem">
                        <button class="play-card-btn" data-index="0" style="max-width:160px">
                            <i class="fas fa-play"></i> <span>Play</span>
                        </button>
                        <a href="/music/random" class="btn-primary"><i class="fas fa-dice"></i> Another Random</a>
                        <a href="/music" class="btn-secondary"><i class="fas fa-list"></i> Browse All</a>
                    </div>
                </div>
            </div>
        </div>
        <% } else { %>
        <div class="no-music">
            <i class="fas fa-music"></i>
            <h3>No music found</h3>
            <p>Start building your collection!</p>
            <a href="/music/add" class="btn-primary"><i class="fas fa-plus"></i> Add Your First Song</a>
        </div>
        <% } %>
    </div>
</main>

<footer class="footer">
    <div class="container"><p>&copy; 2024 Music Discovery Hub. Find your rhythm.</p></div>
</footer>

<%- include('_sticky-player') %>
<script src="/js/player.js"></script>
</body>
</html>
